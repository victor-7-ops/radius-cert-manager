[Unit]
Description=RADIUS Certificate Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=certmgr
Group=certmgr
WorkingDirectory=/opt/certmanager
EnvironmentFile=/opt/certmanager/.env
ExecStart=/opt/certmanager/.venv/bin/python -m uvicorn app.main:create_app --factory --host ${BIND_HOST} --port ${BIND_PORT}
Restart=on-failure
RestartSec=5

# Hardening (handoff §4) — do not remove without a documented reason.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/certmanager
LimitCORE=0

# Defense in depth beyond §4's explicit list.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target

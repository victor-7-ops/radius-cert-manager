PKI_PATH=/opt/certmanager/pki
DB_PATH=/opt/certmanager/certmanager.db
BIND_HOST=192.168.200.18
BIND_PORT=8443
CLIENT_CERT_DAYS=365
CRL_VALIDITY_DAYS=7
CRL_REGEN_HOURS=24

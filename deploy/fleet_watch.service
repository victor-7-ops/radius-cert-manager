[Unit]
Description=Certmanager fleet watch — evaluate every site, alert on status change (HANDOFF-FLEET.md §5.1)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Deployed hosts run certmanager as a Docker container (docker-compose.yml),
# not a host venv — exec into the running container rather than assuming
# /opt/certmanager/.venv exists on the host.
ExecStart=/usr/bin/docker exec certmanager python scripts/fleet_watch.py

# Single pass per run (triggered by fleet_watch.timer), not a daemon —
# matches this repo's existing regenerate_crl_cron.py / retention.py
# pattern. Staleness detection must not depend on someone having the
# /health page open (§5.1) — this is what makes SILENT actually fire.
LimitCORE=0

[Install]
WantedBy=multi-user.target

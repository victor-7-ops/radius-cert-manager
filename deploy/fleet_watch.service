[Unit]
Description=Certmanager fleet watch — evaluate every site, alert on status change (HANDOFF-FLEET.md §5.1)
After=network-online.target

[Service]
Type=oneshot
User=certmgr
Group=certmgr
WorkingDirectory=/opt/certmanager
EnvironmentFile=/opt/certmanager/.env
ExecStart=/opt/certmanager/.venv/bin/python scripts/fleet_watch.py

# Single pass per run (triggered by fleet_watch.timer), not a daemon —
# matches this repo's existing regenerate_crl_cron.py / retention.py
# pattern. Staleness detection must not depend on someone having the
# /health page open (§5.1) — this is what makes SILENT actually fire.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/certmanager
LimitCORE=0

[Install]
WantedBy=multi-user.target

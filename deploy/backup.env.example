# Copy to /opt/certmanager/.env.backup (mode 600, owned by certmgr).
# Kept separate from the app's own .env — a leak of one secrets file
# shouldn't hand over the app AND every past backup archive.
#
# Store this passphrase somewhere that survives the box dying (a
# password manager, not just this file) — it's the only thing that
# makes an encrypted backup restorable instead of just encrypted noise.

BACKUP_PASSPHRASE=replace-with-a-long-random-passphrase

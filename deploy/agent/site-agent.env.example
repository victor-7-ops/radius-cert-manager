# Copy to /opt/certmanager-agent/.env (mode 600, owned by certmgr-agent).
# Never commit a real token — get one from POST /api/admin/sites on the hub.

HUB_URL=https://certmanager.example.internal
SITE_TOKEN=replace-with-the-token-shown-once-at-site-creation
SITE_CN=radius-boracay.internal

# Optional — defaults shown.
# CERT_DIR=/etc/freeradius/3.0/certs
# STATE_DIR=/var/lib/certmanager-agent
# CRL_FILENAME=crl.pem
# SERVER_CERT_FILENAME=server.pem
# SERVER_KEY_FILENAME=server.key
# CA_CHAIN_FILENAME=ca-chain.pem
# FREERADIUS_SERVICE=freeradius
# REQUEST_TIMEOUT_SECONDS=30

[Unit]
Description=RADIUS Certificate Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=certmgr
Group=certmgr
WorkingDirectory=/opt/certmanager
EnvironmentFile=/opt/certmanager/.env
ExecStart=/opt/certmanager/.venv/bin/python scripts/serve.py
# Was `python -m uvicorn app.main:create_app --factory --host ${BIND_HOST}
# --port ${BIND_PORT}` — scripts/serve.py wraps the same call but also
# picks up optional WEB_SSL_KEYFILE/WEB_SSL_CERTFILE from .env
# (HANDOFF-NANO-DEPLOY.md §6), which a systemd ExecStart line can't
# conditionally include. Unset, behavior is identical to before.
Restart=on-failure
RestartSec=5

# Hardening (handoff §4) — do not remove without a documented reason.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/certmanager
LimitCORE=0

# Defense in depth beyond §4's explicit list.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
